<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<title>URAL — A Soviet Horror</title>
<style>
* { margin:0; padding:0; box-sizing:border-box; }
html,body { overflow:hidden; background:#000; color:#ccc; font-family:'Courier New',monospace; user-select:none; }
#game { display:block; width:100vw; height:100vh; }

/* ---------------- HUD ---------------- */
#hud { position:fixed; inset:0; pointer-events:none; z-index:10; }
.bar-label { font-size:12px; letter-spacing:2px; margin-bottom:4px; text-shadow:1px 1px 2px #000; }
.bar-bg { background:rgba(0,0,0,0.75); border:1px solid #2a2a2a; height:14px; position:relative; overflow:hidden; border-radius:2px; }
.bar-fill { height:100%; transition:width 0.08s linear; }
#hp-bar { position:absolute; left:20px; bottom:60px; width:240px; }
#hp-fill { background:linear-gradient(90deg,#400,#a00,#f22); width:100%; }
#pee-bar { position:absolute; left:20px; bottom:20px; width:340px; }
#pee-fill { background:linear-gradient(90deg,#8a6a00,#ffdd00,#fff5a0); width:0%; }
#level-info { position:absolute; top:20px; left:20px; font-size:14px; letter-spacing:3px; text-shadow:2px 2px 3px #000; color:#ddd; }
#level-sub { font-size:11px; color:#888; margin-top:4px; letter-spacing:1px; }
#crosshair { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:6px; height:6px; border-radius:50%; background:rgba(255,255,255,0.7); box-shadow:0 0 3px #000; }
#message { position:absolute; top:28%; left:50%; transform:translate(-50%,-50%); font-size:26px; color:#c88; letter-spacing:6px; text-align:center; opacity:0; transition:opacity 0.5s; text-shadow:0 0 20px #300; }
#message.show { opacity:1; }
#boss-hp { position:absolute; top:36px; left:50%; transform:translateX(-50%); width:520px; display:none; }
#boss-hp .bar-label { text-align:center; color:#c33; letter-spacing:6px; }
#boss-hp-fill { background:linear-gradient(90deg,#300,#a00,#f00); width:100%; }

/* ---------------- Overlays ---------------- */
#damage-overlay { position:fixed; inset:0; pointer-events:none; background:radial-gradient(circle, transparent 30%, rgba(150,0,0,0.75) 100%); opacity:0; transition:opacity 0.15s; z-index:15; }
#damage-overlay.show { opacity:1; }

#flash { position:fixed; inset:0; background:#fff; opacity:0; pointer-events:none; z-index:50; }
#flash.show { opacity:1; }

#fade { position:fixed; inset:0; background:#000; opacity:0; pointer-events:none; z-index:40; transition:opacity 0.55s; }
#fade.show { opacity:1; }

#jumpscare-overlay { position:fixed; inset:0; z-index:100; display:none; background:#000; overflow:hidden; }
#jumpscare-overlay.show { display:block; animation:shake 0.07s infinite; }
#jumpscare-canvas { width:100%; height:100%; display:block; }
@keyframes shake {
0%,100% { transform:translate(0,0) scale(1.0); }
25% { transform:translate(-10px,8px) scale(1.01); }
50% { transform:translate(8px,-6px) scale(1.015); }
75% { transform:translate(-6px,-10px) scale(1.005); }
}

/* ---------------- Screens ---------------- */
#start-screen, #end-screen { position:fixed; inset:0; background:#000; z-index:200; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:20px; }
#start-screen.hidden, #end-screen.hidden { display:none; }
#start-screen h1 { font-size:72px; letter-spacing:16px; color:#8a1a1a; text-shadow:0 0 25px #300,0 0 60px #500; margin-bottom:10px; }
#start-screen h2 { font-size:14px; letter-spacing:8px; color:#555; margin-bottom:44px; }
#start-screen p { font-size:13px; line-height:2; color:#888; max-width:620px; margin-bottom:10px; letter-spacing:1px; }
#start-screen .warn { color:#a33; margin-bottom:34px; }
#start-screen button, #end-screen button { padding:14px 46px; background:#150303; color:#c33; border:1px solid #a22; font-family:inherit; font-size:15px; letter-spacing:5px; cursor:pointer; transition:all 0.3s; margin-top:20px; }
#start-screen button:hover, #end-screen button:hover { background:#3a0a0a; color:#f77; box-shadow:0 0 30px #a22; }
#end-screen h1 { font-size:64px; letter-spacing:14px; margin-bottom:20px; }
#end-screen p { font-size:14px; color:#888; margin-bottom:10px; letter-spacing:2px; }

#pause-hint { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); font-size:22px; color:#999; letter-spacing:6px; display:none; text-shadow:0 0 20px #000; }
#hint { position:absolute; bottom:110px; left:50%; transform:translateX(-50%); font-size:12px; color:#666; letter-spacing:3px; text-align:center; }
</style>
</head>
<body>
<canvas id="game"></canvas>

<div id="hud">
<div id="level-info">AREA 1 / 15</div>
<div id="level-sub">SECTION I — OUTSKIRTS</div>

<div id="hp-bar" class="bar-container">
<div class="bar-label">VITALITY — 30 / 30</div>
<div class="bar-bg"><div id="hp-fill" class="bar-fill"></div></div>
</div>

<div id="pee-bar" class="bar-container">
<div class="bar-label">BLADDER PRESSURE — HOLD LMB</div>
<div class="bar-bg"><div id="pee-fill" class="bar-fill"></div></div>
</div>

<div id="boss-hp" class="bar-container">
<div class="bar-label">THE MOTHER — 300 / 300</div>
<div class="bar-bg"><div id="boss-hp-fill" class="bar-fill"></div></div>
</div>

<div id="crosshair"></div>
<div id="message"></div>
<div id="hint">WASD MOVE — SHIFT SPRINT — SPACE DODGE — LMB PEE — ESC PAUSE</div>
</div>

<div id="damage-overlay"></div>
<div id="flash"></div>
<div id="fade"></div>

<div id="jumpscare-overlay">
<canvas id="jumpscare-canvas"></canvas>
</div>

<div id="start-screen">
<h1>URAL</h1>
<h2>A SOVIET HORROR</h2>
<p>The year is 1987. Something has gone wrong at Facility 14.<br>
You must reach the metro station before dawn.<br>
The only thing that keeps the things away is <span style="color:#ffdd00">your own urine</span>.</p>
<p class="warn">Every 40 seconds, something will find you.<br>15 areas stand between you and the station.</p>
<p style="font-size:11px;color:#555;">WASD to move · SHIFT to sprint · SPACE to dodge · HOLD LEFT MOUSE to urinate · ESC to pause</p>
<button id="start-btn">ENTER THE ZONE</button>
</div>

<div id="end-screen" class="hidden">
<h1 id="end-title">YOU DIED</h1>
<p id="end-sub">The zone claims another.</p>
<button id="restart-btn">TRY AGAIN</button>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
/* =====================================================================
URAL — A SOVIET HORROR
---------------------------------------------------------------------
Technical architecture:
• Three.js WebGL renderer, PCF soft shadows, ACES filmic tone-map
• Procedural canvas textures (no external assets)
• 16 hand-authored level builders (15 areas + metro boss arena)
• First-person pointer-lock controller with sprint and dodge
• 3 hyper-detailed enemy types (pillbug, tapeworm, centipede)
• Boss fight: 300 HP creature damaged by urination
• Scheduled jumpscares: zombie @40s, Chucky @50s, then zombie every 40s
===================================================================== */

'use strict';

/* ============================ RENDERER ============================ */
const canvas = document.getElementById('game');
const renderer = new THREE.WebGLRenderer({ canvas, antialias:true, powerPreference:'high-performance' });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
if (THREE.sRGBEncoding !== undefined) renderer.outputEncoding = THREE.sRGBEncoding;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.15;

const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(72, window.innerWidth/window.innerHeight, 0.05, 500);
camera.rotation.order = 'YXZ';
scene.add(camera);

window.addEventListener('resize', () => {
renderer.setSize(window.innerWidth, window.innerHeight);
camera.aspect = window.innerWidth / window.innerHeight;
camera.updateProjectionMatrix();
});

/* ============================ TEXTURES ============================ */
// Small helper to build canvas textures with optional per-pixel noise.
function makeTexture(size, draw, repeatX = 1, repeatY = 1) {
const c = document.createElement('canvas');
c.width = c.height = size;
const ctx = c.getContext('2d');
draw(ctx, size);
const t = new THREE.CanvasTexture(c);
t.wrapS = t.wrapT = THREE.RepeatWrapping;
t.repeat.set(repeatX, repeatY);
t.anisotropy = 4;
return t;
}
function addNoise(ctx, s, amt) {
const d = ctx.getImageData(0, 0, s, s), p = d.data;
for (let i = 0; i < p.length; i += 4) {
const n = (Math.random() - 0.5) * amt;
p[i] = Math.max(0, Math.min(255, p[i] + n));
p[i+1] = Math.max(0, Math.min(255, p[i+1] + n));
p[i+2] = Math.max(0, Math.min(255, p[i+2] + n));
}
ctx.putImageData(d, 0, 0);
}

const TEX = {};

TEX.dirt = makeTexture(256, (ctx,s) => {
ctx.fillStyle = '#2a1e12'; ctx.fillRect(0,0,s,s);
for (let i=0;i<5000;i++){
ctx.fillStyle = `rgba(${40+Math.random()*50|0},${25+Math.random()*40|0},${15+Math.random()*25|0},${0.4+Math.random()*0.4})`;
ctx.fillRect(Math.random()*s, Math.random()*s, 1+Math.random()*3, 1+Math.random()*3);
}
for (let i=0;i<200;i++){
ctx.strokeStyle = `rgba(15,10,5,${0.3+Math.random()*0.5})`;
ctx.lineWidth = 1;
ctx.beginPath();
const x = Math.random()*s, y = Math.random()*s;
ctx.moveTo(x, y);
ctx.lineTo(x + (Math.random()-0.5)*20, y + (Math.random()-0.5)*20);
ctx.stroke();
}
addNoise(ctx, s, 20);
}, 20, 20);

TEX.concrete = makeTexture(256, (ctx,s) => {
ctx.fillStyle = '#5a5750'; ctx.fillRect(0,0,s,s);
for (let i=0;i<3000;i++){
const v = 60+Math.random()*50|0;
ctx.fillStyle = `rgba(${v},${v-3},${v-8},${0.3+Math.random()*0.3})`;
ctx.fillRect(Math.random()*s, Math.random()*s, 1+Math.random()*2, 1+Math.random()*2);
}
// cracks
for (let i=0;i<10;i++){
ctx.strokeStyle = 'rgba(20,20,20,0.7)';
ctx.lineWidth = 1;
ctx.beginPath();
let x = Math.random()*s, y = Math.random()*s;
ctx.moveTo(x,y);
for (let j=0;j<6;j++){
x += (Math.random()-0.5)*40;
y += (Math.random()-0.5)*40;
ctx.lineTo(x,y);
}
ctx.stroke();
}
addNoise(ctx, s, 15);
}, 8, 8);

TEX.brick = makeTexture(256, (ctx,s) => {
ctx.fillStyle = '#3a2018'; ctx.fillRect(0,0,s,s);
const bw = 32, bh = 16;
for (let y=0;y<s;y+=bh){
for (let x=0;x<s;x+=bw){
const off = (y/bh)%2 ? bw/2 : 0;
const shade = 60+Math.random()*40|0;
ctx.fillStyle = `rgb(${shade+20},${shade-10},${shade-25})`;
ctx.fillRect(x+off+1, y+1, bw-2, bh-2);
}
}
addNoise(ctx, s, 25);
}, 6, 6);

TEX.wood = makeTexture(256, (ctx,s) => {
ctx.fillStyle = '#3a2412'; ctx.fillRect(0,0,s,s);
for (let i=0;i<s;i+=3){
const v = 40+Math.random()*30|0;
ctx.fillStyle = `rgba(${v+20},${v},${v-15},0.6)`;
ctx.fillRect(0, i, s, 2);
}
for (let i=0;i<40;i++){
ctx.strokeStyle = 'rgba(20,10,0,0.4)';
ctx.lineWidth = 1;
ctx.beginPath();
ctx.moveTo(0, Math.random()*s);
ctx.bezierCurveTo(s/3, Math.random()*s, 2*s/3, Math.random()*s, s, Math.random()*s);
ctx.stroke();
}
addNoise(ctx, s, 12);
}, 4, 4);

TEX.metal = makeTexture(256, (ctx,s) => {
ctx.fillStyle = '#3a3a40'; ctx.fillRect(0,0,s,s);
for (let i=0;i<300;i++){
ctx.fillStyle = `rgba(${30+Math.random()*60|0},${30+Math.random()*60|0},${35+Math.random()*60|0},0.4)`;
ctx.fillRect(Math.random()*s, Math.random()*s, 1+Math.random()*8, 1+Math.random()*2);
}
// rust
for (let i=0;i<200;i++){
ctx.fillStyle = `rgba(${100+Math.random()*50|0},${40+Math.random()*30|0},${10+Math.random()*20|0},${Math.random()*0.5})`;
ctx.beginPath();
ctx.arc(Math.random()*s, Math.random()*s, 1+Math.random()*4, 0, Math.PI*2);
ctx.fill();
}
addNoise(ctx, s, 18);
}, 4, 4);

TEX.snow = makeTexture(256, (ctx,s) => {
ctx.fillStyle = '#c8d0d8'; ctx.fillRect(0,0,s,s);
for (let i=0;i<4000;i++){
const v = 180+Math.random()*60|0;
ctx.fillStyle = `rgba(${v},${v+5},${v+10},${0.3})`;
ctx.fillRect(Math.random()*s, Math.random()*s, 1, 1);
}
addNoise(ctx, s, 10);
}, 24, 24);

TEX.tile = makeTexture(256, (ctx,s) => {
ctx.fillStyle = '#b8b0a0'; ctx.fillRect(0,0,s,s);
const t = 32;
for (let y=0;y<s;y+=t){
for (let x=0;x<s;x+=t){
const v = 150+Math.random()*30|0;
ctx.fillStyle = `rgb(${v},${v-5},${v-15})`;
ctx.fillRect(x+1, y+1, t-2, t-2);
}
}
addNoise(ctx, s, 18);
}, 6, 6);

TEX.moss = makeTexture(256, (ctx,s) => {
ctx.fillStyle = '#1e2a14'; ctx.fillRect(0,0,s,s);
for (let i=0;i<8000;i++){
const g = 30+Math.random()*70|0;
ctx.fillStyle = `rgba(${g-10},${g},${g-20},${0.5+Math.random()*0.4})`;
ctx.fillRect(Math.random()*s, Math.random()*s, 1+Math.random()*2, 1+Math.random()*2);
}
addNoise(ctx, s, 12);
}, 8, 8);

TEX.water = makeTexture(256, (ctx,s) => {
ctx.fillStyle = '#0a1418'; ctx.fillRect(0,0,s,s);
for (let i=0;i<2000;i++){
ctx.fillStyle = `rgba(${30+Math.random()*20|0},${60+Math.random()*30|0},${70+Math.random()*30|0},0.3)`;
ctx.fillRect(Math.random()*s, Math.random()*s, 2+Math.random()*4, 1);
}
addNoise(ctx, s, 8);
}, 8, 8);

TEX.rubble = makeTexture(256, (ctx,s) => {
ctx.fillStyle = '#2a2620'; ctx.fillRect(0,0,s,s);
for (let i=0;i<6000;i++){
const v = 30+Math.random()*50|0;
ctx.fillStyle = `rgba(${v},${v-3},${v-8},0.6)`;
ctx.fillRect(Math.random()*s, Math.random()*s, 1+Math.random()*3, 1+Math.random()*3);
}
addNoise(ctx, s, 25);
}, 10, 10);

/* ============================ PROP HELPERS ============================ */
// Standard material cache so we don't rebuild shaders each level.
function matStandard(opts) {
return new THREE.MeshStandardMaterial(opts);
}

function box(w, h, d, mat) {
return new THREE.Mesh(new THREE.BoxGeometry(w, h, d), mat);
}
function cylinder(rTop, rBot, h, segs, mat) {
return new THREE.Mesh(new THREE.CylinderGeometry(rTop, rBot, h, segs), mat);
}

// Reusable material factories
const MAT = {
dirtGround: () => matStandard({ map: TEX.dirt, color: 0x8a7a60, roughness: 0.95 }),
concreteGround: () => matStandard({ map: TEX.concrete, color: 0x888880, roughness: 0.9 }),
snowGround: () => matStandard({ map: TEX.snow, color: 0xffffff, roughness: 0.8 }),
tileGround: () => matStandard({ map: TEX.tile, color: 0xb0a898, roughness: 0.85 }),
mossGround: () => matStandard({ map: TEX.moss, color: 0x8a9070, roughness: 1.0 }),
waterGround: () => matStandard({ map: TEX.water, color: 0x306070, roughness: 0.2, metalness: 0.1 }),
rubbleGround: () => matStandard({ map: TEX.rubble, color: 0x807870, roughness: 1.0 }),
brickWall: (c=0xffffff) => matStandard({ map: TEX.brick, color: c, roughness: 0.95 }),
woodWall: (c=0xffffff) => matStandard({ map: TEX.wood, color: c, roughness: 0.9 }),
metalWall: (c=0xffffff) => matStandard({ map: TEX.metal, color: c, roughness: 0.6, metalness: 0.7 }),
concreteWall: (c=0xffffff) => matStandard({ map: TEX.concrete, color: c, roughness: 0.9 }),
};

/* ============================ PLAYER ============================ */
const player = {
pos: new THREE.Vector3(0, 1.7, 0),
vel: new THREE.Vector3(),
yaw: 0, pitch: 0,
hp: 30, maxHp: 30,
pee: 0, peeMax: 5,
peeing: false,
dodgeCooldown: 0, dodgeTime: 0, dodgeDir: new THREE.Vector3(),
invuln: 0,
hurtFlash: 0,
bob: 0,
};

// Pee stream mesh attached to camera (invisible unless peeing)
const peeStream = new THREE.Mesh(
new THREE.CylinderGeometry(0.02, 0.05, 3.2, 8, 1, true),
new THREE.MeshBasicMaterial({ color: 0xf0d040, transparent: true, opacity: 0.75, side: THREE.DoubleSide })
);
peeStream.rotation.x = Math.PI / 2;
peeStream.position.set(0.15, -0.45, -1.7);
peeStream.visible = false;
camera.add(peeStream);

// Small point light so player can see in dark areas without losing atmosphere
const playerLight = new THREE.PointLight(0xffd8a0, 1.2, 22, 1.6);
playerLight.position.set(0, 0.5, 0);
camera.add(playerLight);

/* ============================ GAME STATE ============================ */
const G = {
running: false,
paused: false,
level: 0,
levels: 15,
inBoss: false,
boss: null,
elapsed: 0,
playerDead: false,
won: false,
enemies: [],
heals: [],
obstacles: [],
levelGroup: null,
spawnTimer: 0,
difficulty: 1,
};

/* Pause, damage overlay, message helpers */
const $ = (id) => document.getElementById(id);
function flashScreen() {
const f = $('flash');
f.classList.add('show');
setTimeout(() => f.classList.remove('show'), 60);
}
function damageFlash() {
const d = $('damage-overlay');
d.classList.add('show');
setTimeout(() => d.classList.remove('show'), 220);
}
function showMessage(text, ms = 1800) {
const m = $('message');
m.textContent = text;
m.classList.add('show');
setTimeout(() => m.classList.remove('show'), ms);
}

/* ============================ LEVEL BUILDER CORE ============================ */
// Every level is ~140 x 140 with 3 thematic "sections" placed around the
// arena. The player starts at origin and may wander to explore while the
// bladder meter fills.

function clearLevel() {
if (!G.levelGroup) return;
scene.remove(G.levelGroup);
G.levelGroup.traverse((o) => {
if (o.geometry) o.geometry.dispose();
if (o.material) {
if (Array.isArray(o.material)) o.material.forEach(m => m.dispose());
else o.material.dispose();
}
});
G.levelGroup = null;
G.enemies.length = 0;
G.heals.length = 0;
G.obstacles.length = 0;
}

function addObstacle(x, z, w, d, h = 3) {
G.obstacles.push({
min: new THREE.Vector3(x - w/2, 0, z - d/2),
max: new THREE.Vector3(x + w/2, h, z + d/2),
});
}

// Generic ground
function buildGround(group, mat, size = 160) {
const g = new THREE.Mesh(new THREE.PlaneGeometry(size, size, 32, 32), mat);
g.rotation.x = -Math.PI / 2;
g.receiveShadow = true;
group.add(g);
}

// Fog + lighting per level
function applyAtmosphere(fogColor, fogDensity, ambientColor, ambientInt, sunColor, sunInt, sunDir) {
scene.fog = new THREE.FogExp2(fogColor, fogDensity);
scene.background = new THREE.Color(fogColor);

const amb = new THREE.AmbientLight(ambientColor, ambientInt);
scene.add(amb);
G._ambient = amb;

const sun = new THREE.DirectionalLight(sunColor, sunInt);
sun.position.copy(sunDir || new THREE.Vector3(40, 80, 30));
sun.castShadow = true;
sun.shadow.mapSize.set(2048, 2048);
sun.shadow.camera.left = -60; sun.shadow.camera.right = 60;
sun.shadow.camera.top = 60; sun.shadow.camera.bottom = -60;
sun.shadow.camera.near = 1; sun.shadow.camera.far = 200;
sun.shadow.bias = -0.0005;
scene.add(sun);
G._sun = sun;

// Fill light to keep dark areas readable (requirement: clear lighting)
const fill = new THREE.HemisphereLight(0x8899aa, 0x111118, 0.55);
scene.add(fill);
G._fill = fill;
}

function clearAtmosphere() {
if (G._ambient) scene.remove(G._ambient);
if (G._sun) scene.remove(G._sun);
if (G._fill) scene.remove(G._fill);
}

// Utility for placing a rectangular building with windows/roof
function buildSimpleBuilding(group, x, z, w, d, h, wallMat, roofMat, windowColor = 0x110a08, lit = false) {
const b = box(w, h, d, wallMat);
b.position.set(x, h/2, z);
b.castShadow = true;
b.receiveShadow = true;
group.add(b);
addObstacle(x, z, w, d, h);

// roof
const roof = box(w + 0.4, 0.3, d + 0.4, roofMat);
roof.position.set(x, h + 0.15, z);
roof.castShadow = true;
group.add(roof);

// windows on 4 sides
const winMat = new THREE.MeshBasicMaterial({ color: windowColor });
const litMat = new THREE.MeshBasicMaterial({ color: 0xffcc66 });
const ww = 0.8, wh = 1.0;
const cols = Math.floor(w / 2);
const rows = Math.floor((h - 1.5) / 1.8);
for (let fy = 0; fy < rows; fy++) {
for (let fx = 0; fx < cols; fx++) {
const wx = x - w/2 + 1.2 + fx * (w - 2.4) / Math.max(1, cols - 1);
const wy = 1.4 + fy * 1.8;
const wm = (lit && Math.random() > 0.7) ? litMat : winMat;
// front
const win1 = new THREE.Mesh(new THREE.PlaneGeometry(ww, wh), wm);
win1.position.set(wx, wy, z + d/2 + 0.02);
group.add(win1);
// back
const win2 = win1.clone();
win2.position.z = z - d/2 - 0.02;
win2.rotation.y = Math.PI;
group.add(win2);
}
}
// side windows
const dcols = Math.floor(d / 2);
for (let fy = 0; fy < rows; fy++) {
for (let fz = 0; fz < dcols; fz++) {
const wz = z - d/2 + 1.2 + fz * (d - 2.4) / Math.max(1, dcols - 1);
const wy = 1.4 + fy * 1.8;
const wm = (lit && Math.random() > 0.7) ? litMat : winMat;
const win1 = new THREE.Mesh(new THREE.PlaneGeometry(ww, wh), wm);
win1.position.set(x + w/2 + 0.02, wy, wz);
win1.rotation.y = Math.PI / 2;
group.add(win1);
const win2 = win1.clone();
win2.position.x = x - w/2 - 0.02;
win2.rotation.y = -Math.PI / 2;
group.add(win2);
}
}
}

function buildTree(group, x, z, h = 6, dead = false, scale = 1) {
const trunkMat = dead
? matStandard({ color: 0x1a1008, roughness: 1.0 })
: matStandard({ color: 0x3a2410, roughness: 1.0 });
const trunk = cylinder(0.15*scale, 0.25*scale, h, 8, trunkMat);
trunk.position.set(x, h/2, z);
trunk.castShadow = true;
group.add(trunk);
addObstacle(x, z, 0.6*scale, 0.6*scale, h);

if (!dead) {
const leafMat = matStandard({ color: 0x1a2a10, roughness: 1.0 });
for (let i = 0; i < 4; i++) {
const leaf = new THREE.Mesh(
new THREE.SphereGeometry((1.2 + Math.random()*0.8)*scale, 8, 6),
leafMat
);
leaf.position.set(
x + (Math.random()-0.5)*1.5*scale,
h - 1 + Math.random()*1.5,
z + (Math.random()-0.5)*1.5*scale
);
leaf.castShadow = true;
group.add(leaf);
}
} else {
// dead branches
const branchMat = matStandard({ color: 0x100804, roughness: 1.0 });
for (let i = 0; i < 5; i++) {
const br = cylinder(0.03*scale, 0.08*scale, (1 + Math.random()*1.5)*scale, 5, branchMat);
const ang = Math.random() * Math.PI * 2;
br.position.set(x + Math.cos(ang)*0.4*scale, h*0.5 + Math.random()*h*0.35, z + Math.sin(ang)*0.4*scale);
br.rotation.z = Math.cos(ang) * 0.8;
br.rotation.x = Math.sin(ang) * 0.8;
br.castShadow = true;
group.add(br);
}
}
}

function buildCrate(group, x, z, size = 1.2, matOverride = null) {
const m = matOverride || matStandard({ map: TEX.wood, color: 0x8a6a40, roughness: 0.9 });
const c = box(size, size, size, m);
c.position.set(x, size/2, z);
c.rotation.y = Math.random() * Math.PI;
c.castShadow = true;
c.receiveShadow = true;
group.add(c);
addObstacle(x, z, size, size, size);
}

function buildBarrel(group, x, z, color = 0x3a2a1a) {
const m = matStandard({ map: TEX.metal, color, roughness: 0.7, metalness: 0.4 });
const b = cylinder(0.4, 0.4, 1.0, 14, m);
b.position.set(x, 0.5, z);
b.castShadow = true;
b.receiveShadow = true;
group.add(b);
addObstacle(x, z, 0.8, 0.8, 1.0);
}

function buildLampPost(group, x, z, color = 0xffddaa, intensity = 1.2) {
const poleMat = matStandard({ color: 0x101010, roughness: 0.6, metalness: 0.7 });
const pole = cylinder(0.06, 0.08, 5, 8, poleMat);
pole.position.set(x, 2.5, z);
pole.castShadow = true;
group.add(pole);
const head = new THREE.Mesh(new THREE.SphereGeometry(0.18, 10, 8), new THREE.MeshBasicMaterial({ color }));
head.position.set(x, 5.1, z);
group.add(head);
const light = new THREE.PointLight(color, intensity, 16, 1.7);
light.position.set(x, 5.0, z);
light.castShadow = false;
group.add(light);
addObstacle(x, z, 0.3, 0.3, 5);
}

function buildRubble(group, x, z, spread = 3, count = 8) {
const rubbleMat = matStandard({ map: TEX.rubble, color: 0x504840, roughness: 1.0 });
for (let i = 0; i < count; i++) {
const r = box(
0.2 + Math.random()*0.6,
0.1 + Math.random()*0.4,
0.2 + Math.random()*0.6,
rubbleMat
);
r.position.set(x + (Math.random()-0.5)*spread, 0.2, z + (Math.random()-0.5)*spread);
r.rotation.set(Math.random()*3, Math.random()*3, Math.random()*3);
r.castShadow = true;
group.add(r);
}
}

function buildPipeRun(group, x1, z1, x2, z2, y = 3, color = 0x8a3a1a) {
const dx = x2 - x1, dz = z2 - z1;
const len = Math.hypot(dx, dz);
const m = matStandard({ map: TEX.metal, color, roughness: 0.5, metalness: 0.8 });
const pipe = cylinder(0.15, 0.15, len, 10, m);
pipe.position.set((x1+x2)/2, y, (z1+z2)/2);
pipe.rotation.z = Math.PI/2;
pipe.rotation.y = Math.atan2(dz, dx);
pipe.castShadow = true;
group.add(pipe);
// supports
for (let t = 0.2; t <= 0.8; t += 0.4) {
const px = x1 + dx*t, pz = z1 + dz*t;
const s = cylinder(0.06, 0.06, y, 6, m);
s.position.set(px, y/2, pz);
group.add(s);
}
}


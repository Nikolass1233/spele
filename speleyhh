/* ============================ ENEMIES ============================ */
function enemyMaterial(tint) {
return matStandard({ color: tint, roughness: 0.85, metalness: 0.05 });
}

// --- Pillbug (segmented armoured roly-poly) ---
function createPillbug() {
const g = new THREE.Group();
const segs = 9;
const segMat = enemyMaterial(0x2e2620);
for (let i = 0; i < segs; i++) {
const r = 0.5 - Math.abs(i - segs/2) * 0.035;
const seg = new THREE.Mesh(new THREE.SphereGeometry(r, 14, 12), segMat);
seg.position.z = (i - segs/2) * 0.32;
seg.castShadow = true;
g.add(seg);
}
// Legs
const legMat = enemyMaterial(0x0e0a08);
for (let i = 0; i < segs; i++) {
for (let s = -1; s <= 1; s += 2) {
const leg = cylinder(0.03, 0.02, 0.45, 5, legMat);
leg.position.set(s * 0.42, -0.32, (i - segs/2) * 0.32);
leg.rotation.z = s * 0.7;
leg.castShadow = true;
g.add(leg);
}
}
// Glowing eyes
const eyeMat = new THREE.MeshBasicMaterial({ color: 0xff2200 });
for (let s = -1; s <= 1; s += 2) {
const eye = new THREE.Mesh(new THREE.SphereGeometry(0.06, 8, 6), eyeMat);
eye.position.set(s * 0.15, 0.2, -segs/2 * 0.32 - 0.3);
g.add(eye);
}
// Antennae
for (let s = -1; s <= 1; s += 2) {
const ant = cylinder(0.015, 0.01, 0.6, 4, legMat);
ant.position.set(s * 0.1, 0.4, -segs/2 * 0.32 - 0.2);
ant.rotation.x = -0.5;
ant.rotation.z = s * 0.3;
g.add(ant);
}
g.userData = { type: 'pillbug', speed: 2.2, hp: 3, w: 1.2, wiggles: 0, hurtCooldown: 0 };
return g;
}

// --- Tapeworm (long undulating segments) ---
function createTapeworm() {
const g = new THREE.Group();
const segs = 14;
const segMat = enemyMaterial(0x8a4a5a);
for (let i = 0; i < segs; i++) {
const r = 0.28 - i * 0.01;
const seg = new THREE.Mesh(new THREE.SphereGeometry(r, 12, 10), segMat);
seg.position.z = i * 0.35;
seg.castShadow = true;
g.add(seg);
}
// Mouth
const mouthMat = new THREE.MeshBasicMaterial({ color: 0x3a0a0a });
const mouth = new THREE.Mesh(new THREE.ConeGeometry(0.2, 0.4, 8), mouthMat);
mouth.position.z = -0.25;
mouth.rotation.x = Math.PI;
g.add(mouth);
// Teeth ring
const toothMat = matStandard({ color: 0xe0d8a0, roughness: 0.6 });
for (let i = 0; i < 8; i++) {
const a = (i / 8) * Math.PI * 2;
const tooth = new THREE.Mesh(new THREE.ConeGeometry(0.03, 0.12, 4), toothMat);
tooth.position.set(Math.cos(a)*0.18, Math.sin(a)*0.18, -0.3);
tooth.lookAt(0, 0, 0);
tooth.rotateX(Math.PI);
g.add(tooth);
}
// Eyes
const eyeMat = new THREE.MeshBasicMaterial({ color: 0xffaa00 });
for (let s = -1; s <= 1; s += 2) {
const eye = new THREE.Mesh(new THREE.SphereGeometry(0.05, 8, 6), eyeMat);
eye.position.set(s * 0.12, 0.15, -0.35);
g.add(eye);
}
g.userData = { type: 'tapeworm', speed: 3.4, hp: 2, w: 2.4, wiggles: 0, hurtCooldown: 0 };
return g;
}

// --- Centipede (many legs, fast) ---
function createCentipede() {
const g = new THREE.Group();
const segs = 16;
const segMat = enemyMaterial(0x6a2a2a);
for (let i = 0; i < segs; i++) {
const r = 0.35 - Math.abs(i - segs/2) * 0.012;
const seg = new THREE.Mesh(new THREE.SphereGeometry(r, 12, 10), segMat);
seg.position.z = (i - segs/2) * 0.28;
seg.castShadow = true;
g.add(seg);
}
// Many legs
const legMat = enemyMaterial(0x3a1a0a);
for (let i = 0; i < segs; i++) {
for (let s = -1; s <= 1; s += 2) {
const leg = cylinder(0.025, 0.015, 0.6, 5, legMat);
leg.position.set(s * 0.35, -0.28, (i - segs/2) * 0.28);
leg.rotation.z = s * 0.8;
leg.castShadow = true;
g.add(leg);
}
}
// Forked tail (venomous)
const tailMat = enemyMaterial(0x8a1a1a);
for (let s = -1; s <= 1; s += 2) {
const t = new THREE.Mesh(new THREE.ConeGeometry(0.05, 0.5, 6), tailMat);
t.position.set(s * 0.15, 0, segs/2 * 0.28 + 0.2);
t.rotation.x = -Math.PI/2 - 0.3;
t.rotation.z = s * 0.2;
g.add(t);
}
// Head
const headMat = enemyMaterial(0x4a1a0a);
const head = new THREE.Mesh(new THREE.SphereGeometry(0.45, 14, 12), headMat);
head.position.z = -segs/2 * 0.28 - 0.15;
head.castShadow = true;
g.add(head);
const eyeMat = new THREE.MeshBasicMaterial({ color: 0xff2200 });
for (let s = -1; s <= 1; s += 2) {
const eye = new THREE.Mesh(new THREE.SphereGeometry(0.06, 8, 6), eyeMat);
eye.position.set(s * 0.2, 0.15, -segs/2 * 0.28 - 0.35);
g.add(eye);
}
// Mandibles
for (let s = -1; s <= 1; s += 2) {
const m = new THREE.Mesh(new THREE.ConeGeometry(0.04, 0.25, 5), matStandard({ color: 0xe0c080 }));
m.position.set(s * 0.12, -0.1, -segs/2 * 0.28 - 0.4);
m.rotation.x = -Math.PI/2;
m.rotation.z = s * 0.3;
g.add(m);
}
g.userData = { type: 'centipede', speed: 4.6, hp: 4, w: 2.6, wiggles: 0, hurtCooldown: 0 };
return g;
}

function spawnEnemy(kind, pos) {
let e;
if (kind === 'pillbug') e = createPillbug();
else if (kind === 'tapeworm') e = createTapeworm();
else e = createCentipede();
e.position.copy(pos);
e.position.y = 0.6;
scene.add(e);
G.enemies.push(e);
return e;
}

function updateEnemies(dt) {
const t = performance.now() * 0.001;
for (let i = G.enemies.length - 1; i >= 0; i--) {
const e = G.enemies[i];
const d = e.userData;
// Move toward player (with slight avoidance of obstacles via simple steering)
const toPlayer = new THREE.Vector3().subVectors(player.pos, e.position);
toPlayer.y = 0;
const dist = toPlayer.length();
toPlayer.normalize();

// Gentle wiggle
d.wiggles += dt;
const wiggle = Math.sin(d.wiggles * 6) * 0.15;

if (dist > 1.4) {
const step = d.speed * dt;
e.position.x += toPlayer.x * step;
e.position.z += toPlayer.z * step;
// face player
const ang = Math.atan2(toPlayer.x, toPlayer.z);
e.rotation.y = ang + wiggle * 0.3;
}

// Segment animation (undulation)
e.children.forEach((c, idx) => {
if (c.position.z !== undefined && idx < 18) {
c.position.x = Math.sin(t * 4 + idx * 0.4) * 0.06;
}
});

// Attack
d.hurtCooldown -= dt;
if (dist < 1.8 && d.hurtCooldown <= 0 && player.invuln <= 0 && !player.peeing) {
damagePlayer(1);
d.hurtCooldown = 1.6;
// knockback
const kb = new THREE.Vector3().subVectors(player.pos, e.position).normalize().multiplyScalar(0.6);
player.pos.add(kb);
} else if (dist < 1.8 && d.hurtCooldown <= 0 && player.peeing) {
// Peeing scares them off — takes a step back
const push = new THREE.Vector3().subVectors(e.position, player.pos).normalize().multiplyScalar(0.5);
e.position.add(push);
d.hurtCooldown = 1.2;
}

// Despawn if too far
if (dist > 90) {
scene.remove(e);
G.enemies.splice(i, 1);
}
}
}

/* ============================ HEALING ITEMS ============================ */
function spawnHeal() {
const g = new THREE.Group();
const outer = new THREE.Mesh(
new THREE.OctahedronGeometry(0.35, 0),
matStandard({ color: 0xff2244, emissive: 0xaa0022, emissiveIntensity: 0.8, roughness: 0.4 })
);
outer.castShadow = true;
g.add(outer);
const inner = new THREE.Mesh(
new THREE.OctahedronGeometry(0.2, 0),
new THREE.MeshBasicMaterial({ color: 0xffddaa })
);
g.add(inner);
const light = new THREE.PointLight(0xff3366, 1.2, 8, 2);
g.add(light);
g.position.set(
-40 + Math.random()*80,
1.2,
-40 + Math.random()*80
);
g.userData = { spin: 0, bob: 0, baseY: g.position.y };
scene.add(g);
G.heals.push(g);
}

function updateHeals(dt) {
for (let i = G.heals.length - 1; i >= 0; i--) {
const h = G.heals[i];
h.userData.spin += dt * 2;
h.userData.bob += dt * 3;
h.rotation.y = h.userData.spin;
h.position.y = h.userData.baseY + Math.sin(h.userData.bob) * 0.2;
if (h.position.distanceTo(player.pos) < 1.5) {
player.hp = player.maxHp;
updateHUD();
showMessage('+ VITALITY RESTORED +', 1400);
flashScreen();
scene.remove(h);
G.heals.splice(i, 1);
}
}
}

/* ============================ BOSS ============================ */
function createBoss() {
const g = new THREE.Group();

// Massive segmented worm body (the "Mother")
const bodyMat = matStandard({ color: 0x5a1a1a, roughness: 0.55, metalness: 0.1 });
const segs = 14;
const bodySegs = [];
for (let i = 0; i < segs; i++) {
const r = 2.2 - i * 0.1;
const seg = new THREE.Mesh(new THREE.SphereGeometry(r, 20, 16), bodyMat);
seg.position.y = i * 1.6;
seg.castShadow = true;
seg.receiveShadow = true;
g.add(seg);
bodySegs.push(seg);
}
g.userData.bodySegs = bodySegs;

// Head with fleshy features
const headMat = matStandard({ color: 0x8a2a1a, roughness: 0.5, metalness: 0.1 });
const head = new THREE.Mesh(new THREE.SphereGeometry(2.6, 20, 16), headMat);
head.position.y = segs * 1.6;
head.castShadow = true;
g.add(head);
g.userData.head = head;

// Mouth - giant gaping maw
const mouthMat = matStandard({ color: 0x1a0000, roughness: 0.4, emissive: 0x3a0000, emissiveIntensity: 0.3 });
const mouth = new THREE.Mesh(new THREE.SphereGeometry(1.5, 16, 12), mouthMat);
mouth.position.set(0, segs * 1.6 - 0.2, -1.6);
mouth.scale.set(1, 1.2, 0.6);
g.add(mouth);

// Rows of teeth
const toothMat = matStandard({ color: 0xd8c898, roughness: 0.4, metalness: 0.2 });
for (let row = 0; row < 3; row++) {
for (let i = 0; i < 10; i++) {
const a = (i / 10) * Math.PI * 2;
const t = new THREE.Mesh(new THREE.ConeGeometry(0.15, 0.6, 6), toothMat);
t.position.set(
Math.cos(a) * 1.4,
segs * 1.6 - 0.2 + Math.sin(a) * 1.4,
-1.8 + row * 0.25
);
t.rotation.x = Math.PI/2;
t.rotation.z = -a;
g.add(t);
}
}

// Eyes - multiple glowing
const eyeMat = new THREE.MeshBasicMaterial({ color: 0xff2200 });
const eyePositions = [
[-1.2, segs*1.6 + 1.3, -1.6], [1.2, segs*1.6 + 1.3, -1.6],
[-1.8, segs*1.6 + 0.5, -1.8], [1.8, segs*1.6 + 0.5, -1.8],
[-0.6, segs*1.6 + 1.8, -1.4], [0.6, segs*1.6 + 1.8, -1.4],
[-2.2, segs*1.6 - 0.3, -1.6], [2.2, segs*1.6 - 0.3, -1.6],
];
eyePositions.forEach(([x, y, z]) => {
const eye = new THREE.Mesh(new THREE.SphereGeometry(0.28, 10, 8), eyeMat);
eye.position.set(x, y, z);
g.add(eye);
});

// Arms/tentacles hanging from body
const tentMat = matStandard({ color: 0x4a0a0a, roughness: 0.6 });
for (let s = -1; s <= 1; s += 2) {
for (let t = 0; t < 3; t++) {
const tent = new THREE.Group();
let prevR = 0.35, prevY = 0, prevX = 0;
for (let j = 0; j < 8; j++) {
const r = 0.35 - j * 0.03;
const seg = new THREE.Mesh(new THREE.SphereGeometry(r, 8, 6), tentMat);
seg.position.set(prevX, prevY, 0);
seg.castShadow = true;
tent.add(seg);
prevX += Math.sin(j * 0.3 + t) * 0.15 * s;
prevY -= 0.35;
}
tent.position.set(s * 2.2, segs * 1.6 - 1.5 - t * 1.2, 0);
g.add(tent);
}
}

// Pustules across body
const pustMat = matStandard({ color: 0xaa3a2a, emissive: 0x3a0a00, emissiveIntensity: 0.4, roughness: 0.5 });
for (let i = 0; i < 30; i++) {
const s = bodySegs[Math.floor(Math.random() * segs)];
if (!s) continue;
const a = Math.random() * Math.PI * 2;
const p = new THREE.Mesh(new THREE.SphereGeometry(0.15 + Math.random()*0.1, 8, 6), pustMat);
p.position.set(
s.position.x + Math.cos(a) * 2.0,
s.position.y + (Math.random()-0.5) * 1.0,
s.position.z + Math.sin(a) * 2.0
);
g.add(p);
}

// Dark ambient glow
const bossLight = new THREE.PointLight(0xff2200, 3.0, 30, 1.4);
bossLight.position.set(0, segs * 1.6 - 2, -1);
g.add(bossLight);

g.userData.hp = 300;
g.userData.maxHp = 300;
g.userData.attackCd = 0;
g.userData.attackCharge = 0;
g.userData.time = 0;
return g;
}

function updateBoss(dt) {
if (!G.boss) return;
const b = G.boss;
const d = b.userData;
d.time += dt;

// Slow undulation
if (d.bodySegs) {
d.bodySegs.forEach((s, i) => {
s.position.x = Math.sin(d.time * 0.8 + i * 0.4) * 0.4;
s.position.z = Math.cos(d.time * 0.6 + i * 0.3) * 0.3;
});
}

// Move slowly toward player
const toP = new THREE.Vector3().subVectors(player.pos, b.position);
toP.y = 0;
const dist = toP.length();
if (dist > 6) {
toP.normalize();
b.position.x += toP.x * 1.2 * dt;
b.position.z += toP.z * 1.2 * dt;
}
// Face player
b.rotation.y = Math.atan2(toP.x, toP.z) + Math.PI;

// Attack cycle
d.attackCd -= dt;
if (d.attackCd <= 0 && dist < 12) {
// Telegraph
d.attackCharge += dt;
b.children.forEach(c => {
if (c.material && c.material.emissive) {
c.material.emissiveIntensity = 0.3 + d.attackCharge * 0.8;
}
});
if (d.attackCharge > 1.5) {
// Attack!
if (dist < 9 && player.invuln <= 0) damagePlayer(1);
d.attackCd = 4.5;
d.attackCharge = 0;
b.children.forEach(c => {
if (c.material && c.material.emissive) c.material.emissiveIntensity = 0.3;
});
}
}

// Pee damage
if (player.peeing && dist < 10) {
d.hp -= dt; // 1 HP per second of urination
if (d.hp < 0) d.hp = 0;
updateBossHUD();
if (d.hp <= 0) {
winGame();
}
}

updateBossHUD();
}

/* ============================ PLAYER DAMAGE & HUD ============================ */
function damagePlayer(amt) {
if (player.invuln > 0) return;
player.hp -= amt;
player.hurtFlash = 0.4;
damageFlash();
if (player.hp <= 0) {
player.hp = 0;
updateHUD();
die();
return;
}
updateHUD();
}

function updateHUD() {
$('hp-fill').style.width = (player.hp / player.maxHp * 100) + '%';
document.querySelector('#hp-bar .bar-label').textContent =
`VITALITY — ${Math.ceil(player.hp)} / ${player.maxHp}`;
let pct = 0;
if (G.inBoss) {
pct = 100;
} else {
pct = (player.pee / player.peeMax) * 100;
}
$('pee-fill').style.width = pct + '%';
}

function updateBossHUD() {
if (!G.boss) return;
const d = G.boss.userData;
$('boss-hp-fill').style.width = (d.hp / d.maxHp * 100) + '%';
document.querySelector('#boss-hp .bar-label').textContent =
`THE MOTHER — ${Math.ceil(d.hp)} / ${d.maxHp}`;
}

function showBossHUD(show) {
$('boss-hp').style.display = show ? 'block' : 'none';
}

/* ============================ LEVEL LOAD ============================ */
function loadLevel(index) {
clearLevel();
clearAtmosphere();

const cfg = LEVELS[index];
G.level = index;

// Level group
G.levelGroup = cfg.build();
scene.add(G.levelGroup);

// Player spawn at origin
player.pos.set(0, 1.7, 0);
player.vel.set(0, 0, 0);
player.yaw = 0;
player.pitch = 0;

// Reset pee for new level
player.pee = 0;
player.peeMax = cfg.peeMax;
updateHUD();

// HUD labels
$('level-info').textContent = cfg.name;
$('level-sub').textContent = cfg.sub;

// Spawn enemies
G.enemies.length = 0;
const kinds = ['pillbug', 'tapeworm', 'centipede'];
for (let i = 0; i < cfg.enemies; i++) {
const k = kinds[Math.floor(Math.random() * 3)];
const ang = Math.random() * Math.PI * 2;
const rad = 22 + Math.random() * 20;
spawnEnemy(k, new THREE.Vector3(Math.cos(ang)*rad, 0, Math.sin(ang)*rad));
}

// Heal items
G.heals.length = 0;
if (index < 15 && Math.random() < 0.8) spawnHeal();
if (index < 15 && Math.random() < 0.4) spawnHeal();

// Boss
if (cfg.isBoss) {
G.inBoss = true;
showBossHUD(true);
G.boss = createBoss();
G.boss.position.set(0, 0, -18);
scene.add(G.boss);
showMessage('THE MOTHER AWAKENS', 3200);
} else {
G.inBoss = false;
showBossHUD(false);
if (G.boss) { scene.remove(G.boss); G.boss = null; }
}
}

function advanceLevel() {
if (G.level < LEVELS.length - 1) {
showMessage('THE PRESSURE SUBSIDES — NEXT ZONE', 1500);
const fade = $('fade');
fade.classList.add('show');
setTimeout(() => {
loadLevel(G.level + 1);
fade.classList.remove('show');
}, 600);
}
}

/* ============================ JUMPSCARES ============================ */
const jumpscareCanvas = document.getElementById('jumpscare-canvas');
const jsCtx = jumpscareCanvas.getContext('2d');
let jsActive = false;
let jsEndTime = 0;
let jsType = 'zombie';

function drawZombieFace(ctx, w, h) {
// Background
ctx.fillStyle = '#000';
ctx.fillRect(0, 0, w, h);

// Skull
const cx = w/2, cy = h/2;
ctx.save();
ctx.translate(cx, cy);
ctx.scale(1.05, 1.15);

// Head base
const grd = ctx.createRadialGradient(0, -h*0.05, h*0.05, 0, 0, h*0.45);
grd.addColorStop(0, '#8a9080');
grd.addColorStop(0.5, '#4a5040');
grd.addColorStop(1, '#1a1a10');
ctx.fillStyle = grd;
ctx.beginPath();
ctx.ellipse(0, 0, w*0.34, h*0.42, 0, 0, Math.PI*2);
ctx.fill();

// Skull shadows / sockets
ctx.fillStyle = '#050505';
ctx.beginPath();
ctx.ellipse(-w*0.14, -h*0.08, w*0.09, h*0.11, 0.15, 0, Math.PI*2);
ctx.ellipse( w*0.14, -h*0.08, w*0.09, h*0.11, -0.15, 0, Math.PI*2);
ctx.fill();

// Red glow eyes
for (const sx of [-1, 1]) {
const g = ctx.createRadialGradient(sx*w*0.14, -h*0.08, 0, sx*w*0.14, -h*0.08, w*0.09);
g.addColorStop(0, 'rgba(255,40,20,0.95)');
g.addColorStop(0.4, 'rgba(200,0,0,0.7)');
g.addColorStop(1, 'rgba(80,0,0,0)');
ctx.fillStyle = g;
ctx.beginPath();
ctx.arc(sx*w*0.14, -h*0.08, w*0.1, 0, Math.PI*2);
ctx.fill();
// pupil
ctx.fillStyle = '#000';
ctx.beginPath();
ctx.arc(sx*w*0.14, -h*0.08, w*0.02, 0, Math.PI*2);
ctx.fill();
}

// Torn mouth
ctx.fillStyle = '#0a0202';
ctx.beginPath();
ctx.ellipse(0, h*0.16, w*0.17, h*0.14, 0, 0, Math.PI*2);
ctx.fill();

// Teeth
ctx.fillStyle = '#d8c898';
for (let i = 0; i < 8; i++) {
const tx = -w*0.15 + i*w*0.04;
ctx.beginPath();
ctx.moveTo(tx, h*0.06);
ctx.lineTo(tx + w*0.02, h*0.11);
ctx.lineTo(tx + w*0.04, h*0.06);
ctx.closePath();
ctx.fill();
ctx.beginPath();
ctx.moveTo(tx, h*0.26);
ctx.lineTo(tx + w*0.02, h*0.21);
ctx.lineTo(tx + w*0.04, h*0.26);
ctx.closePath();
ctx.fill();
}

// Blood drips
ctx.fillStyle = 'rgba(120, 10, 10, 0.85)';
for (let i = 0; i < 12; i++) {
const x = (Math.random() - 0.5) * w * 0.5;
const y = h * 0.15 + Math.random() * h * 0.25;
ctx.fillRect(x, y, w * 0.01, h * 0.06 + Math.random() * h * 0.1);
}

// Veins
ctx.strokeStyle = 'rgba(40,20,10,0.6)';
ctx.lineWidth = 2;
for (let i = 0; i < 20; i++) {
ctx.beginPath();
const x0 = (Math.random() - 0.5) * w * 0.6;
const y0 = (Math.random() - 0.5) * h * 0.7;
ctx.moveTo(x0, y0);
ctx.lineTo(x0 + (Math.random() - 0.5) * w * 0.1, y0 + (Math.random() - 0.5) * h * 0.1);
ctx.stroke();
}

ctx.restore();

// Grain
const img = ctx.getImageData(0, 0, w, h);
const p = img.data;
for (let i = 0; i < p.length; i += 4) {
const n = (Math.random() - 0.5) * 30;
p[i] += n; p[i+1] += n; p[i+2] += n;
}
ctx.putImageData(img, 0, 0);
}

function drawChuckyFace(ctx, w, h) {
ctx.fillStyle = '#000';
ctx.fillRect(0, 0, w, h);

const cx = w/2, cy = h/2;
ctx.save();
ctx.translate(cx, cy);

// Hair (orange, spiky)
ctx.fillStyle = '#8a2a1a';
for (let i = 0; i < 40; i++) {
ctx.beginPath();
const a = Math.random() * Math.PI * 2;
const len = h * 0.25 + Math.random() * h * 0.15;
ctx.moveTo(Math.cos(a) * w * 0.25, -h*0.05 + Math.sin(a) * h * 0.25);
ctx.lineTo(Math.cos(a) * w * 0.32 + (Math.random()-0.5)*40, -h*0.15 + Math.sin(a) * h * 0.32 + (Math.random()-0.5)*40);
ctx.lineTo(Math.cos(a) * w * 0.28, -h*0.1 + Math.sin(a) * h * 0.28);
ctx.fill();
}

// Head
const grd = ctx.createRadialGradient(0, 0, h*0.05, 0, 0, h*0.4);
grd.addColorStop(0, '#f0d0a8');
grd.addColorStop(1, '#a07050');
ctx.fillStyle = grd;
ctx.beginPath();
ctx.ellipse(0, 0, w*0.32, h*0.4, 0, 0, Math.PI*2);
ctx.fill();

// Hair on top
ctx.fillStyle = '#8a2a1a';
ctx.beginPath();
ctx.ellipse(0, -h*0.28, w*0.3, h*0.15, 0, 0, Math.PI*2);
ctx.fill();

// Cheeks (rosy, doll-like)
ctx.fillStyle = 'rgba(200, 60, 60, 0.55)';
ctx.beginPath();
ctx.arc(-w*0.18, h*0.05, w*0.06, 0, Math.PI*2);
ctx.arc( w*0.18, h*0.05, w*0.06, 0, Math.PI*2);
ctx.fill();

// Eyes (large, blue)
for (const sx of [-1, 1]) {
// socket shadow
ctx.fillStyle = '#4a2a1a';
ctx.beginPath();
ctx.ellipse(sx*w*0.14, -h*0.06, w*0.1, h*0.11, 0, 0, Math.PI*2);
ctx.fill();
// eye white
ctx.fillStyle = '#e0e0d8';
ctx.beginPath();
ctx.ellipse(sx*w*0.14, -h*0.06, w*0.08, h*0.09, 0, 0, Math.PI*2);
ctx.fill();
// iris
ctx.fillStyle = '#1a4a8a';
ctx.beginPath();
ctx.arc(sx*w*0.14, -h*0.05, w*0.045, 0, Math.PI*2);
ctx.fill();
// pupil
ctx.fillStyle = '#000';
ctx.beginPath();
ctx.arc(sx*w*0.14, -h*0.05, w*0.02, 0, Math.PI*2);
ctx.fill();
// highlight
ctx.fillStyle = '#fff';
ctx.beginPath();
ctx.arc(sx*w*0.14 - w*0.015, -h*0.065, w*0.01, 0, Math.PI*2);
ctx.fill();
}

// Stitched mouth
ctx.strokeStyle = '#3a1a0a';
ctx.lineWidth = 3;
ctx.beginPath();
ctx.moveTo(-w*0.15, h*0.2);
ctx.bezierCurveTo(-w*0.05, h*0.28, w*0.05, h*0.28, w*0.15, h*0.2);
ctx.stroke();
// Stitches crossing mouth
for (let i = 0; i < 10; i++) {
const x = -w*0.14 + (i/9) * w*0.28;
ctx.beginPath();
ctx.moveTo(x - 4, h*0.22);
ctx.lineTo(x + 4, h*0.24);
ctx.stroke();
}

// Stitched seam down face
ctx.beginPath();
ctx.moveTo(0, -h*0.28);
ctx.lineTo(0, -h*0.12);
ctx.stroke();
for (let i = 0; i < 4; i++) {
ctx.beginPath();
ctx.moveTo(-8, -h*0.26 + i * h*0.04);
ctx.lineTo(8, -h*0.24 + i * h*0.04);
ctx.stroke();
}

// Veins / scars
ctx.strokeStyle = 'rgba(80, 20, 10, 0.7)';
ctx.lineWidth = 1.5;
for (let i = 0; i < 15; i++) {
const x0 = (Math.random() - 0.5) * w * 0.5;
const y0 = (Math.random() - 0.5) * h * 0.6;
ctx.beginPath();
ctx.moveTo(x0, y0);
ctx.lineTo(x0 + (Math.random()-0.5) * w * 0.15, y0 + (Math.random()-0.5) * h * 0.15);
ctx.stroke();
}

ctx.restore();

// Grain
const img = ctx.getImageData(0, 0, w, h);
const p = img.data;
for (let i = 0; i < p.length; i += 4) {
const n = (Math.random() - 0.5) * 25;
p[i] += n; p[i+1] += n; p[i+2] += n;
}
ctx.putImageData(img, 0, 0);
}

function triggerJumpscare(type) {
jsActive = true;
jsType = type;
const dpr = Math.min(window.devicePixelRatio, 2);
jumpscareCanvas.width = window.innerWidth * dpr;
jumpscareCanvas.height = window.innerHeight * dpr;
jsCtx.save();
jsCtx.scale(dpr, dpr);
if (type === 'chucky') {
drawChuckyFace(jsCtx, window.innerWidth, window.innerHeight);
} else {
drawZombieFace(jsCtx, window.innerWidth, window.innerHeight);
}
jsCtx.restore();

$('jumpscare-overlay').classList.add('show');
jsEndTime = performance.now() + 950;

// Scare sound
playScareSound(type);
}

function playScareSound(type) {
try {
const AC = window.AudioContext || window.webkitAudioContext;
if (!AC) return;
if (!playScareSound.ctx) playScareSound.ctx = new AC();
const ctx = playScareSound.ctx;
if (ctx.state === 'suspended') ctx.resume();

// Noise burst
const dur = 0.9;
const buf = ctx.createBuffer(1, ctx.sampleRate * dur, ctx.sampleRate);
const data = buf.getChannelData(0);
for (let i = 0; i < data.length; i++) {
data[i] = (Math.random() * 2 - 1) * (1 - i/data.length) * 0.9;
}
const src = ctx.createBufferSource();
src.buffer = buf;
const gain = ctx.createGain();
gain.gain.value = 0.6;
const filter = ctx.createBiquadFilter();
filter.type = 'bandpass';
filter.frequency.value = type === 'chucky' ? 1800 : 900;
filter.Q.value = 1.5;
src.connect(filter).connect(gain).connect(ctx.destination);
src.start();
// Tremolo
const osc = ctx.createOscillator();
osc.type = 'sawtooth';
osc.frequency.value = type === 'chucky' ? 440 : 110;
const og = ctx.createGain();
og.gain.value = 0.08;
osc.connect(og).connect(ctx.destination);
osc.start();
osc.stop(ctx.currentTime + dur);
} catch (e) { /* silent */ }
}

/* ============================ INPUT ============================ */
const keys = {};
window.addEventListener('keydown', (e) => {
keys[e.code] = true;
if (e.code === 'Escape') togglePause();
});
window.addEventListener('keyup', (e) => { keys[e.code] = false; });

canvas.addEventListener('mousedown', (e) => {
if (e.button === 0) {
if (document.pointerLockElement === canvas) player.peeing = true;
}
});
window.addEventListener('mouseup', (e) => {
if (e.button === 0) player.peeing = false;
});
canvas.addEventListener('click', () => {
if (G.running && !G.paused && document.pointerLockElement !== canvas) {
canvas.requestPointerLock();
}
});

document.addEventListener('mousemove', (e) => {
if (document.pointerLockElement === canvas) {
const sens = 0.0022;
player.yaw -= e.movementX * sens;
player.pitch -= e.movementY * sens;
player.pitch = Math.max(-Math.PI/2 + 0.05, Math.min(Math.PI/2 - 0.05, player.pitch));
}
});

window.addEventListener('blur', () => { player.peeing = false; });

/* ============================ PAUSE ============================ */
function togglePause() {
if (!G.running) return;
G.paused = !G.paused;
const p = $('pause-hint');
p.style.display = G.paused ? 'block' : 'none';
p.textContent = 'PAUSED — PRESS ESC TO RESUME';
if (!G.paused) canvas.requestPointerLock();
else document.exitPointerLock && document.exitPointerLock();
}

/* ============================ PLAYER UPDATE ============================ */
function updatePlayer(dt) {
// Timers
if (player.invuln > 0) player.invuln -= dt;
if (player.hurtFlash > 0) player.hurtFlash -= dt;
if (player.dodgeCooldown > 0) player.dodgeCooldown -= dt;

// Movement input
const fwd = new THREE.Vector3(-Math.sin(player.yaw), 0, -Math.cos(player.yaw));
const right = new THREE.Vector3(Math.cos(player.yaw), 0, -Math.sin(player.yaw));
const input = new THREE.Vector3();
if (keys['KeyW']) input.add(fwd);
if (keys['KeyS']) input.sub(fwd);
if (keys['KeyA']) input.sub(right);
if (keys['KeyD']) input.add(right);
if (input.lengthSq() > 0) input.normalize();

const sprinting = keys['ShiftLeft'] || keys['ShiftRight'];
const speed = sprinting ? 8.5 : 4.8;

// Dodge (Space)
if (keys['Space'] && player.dodgeCooldown <= 0 && input.lengthSq() > 0) {
player.dodgeCooldown = 1.6;
player.dodgeTime = 0.35;
player.dodgeDir.copy(input);
player.invuln = 0.45;
}

if (player.dodgeTime > 0) {
// Dash burst
const dashSpeed = 22;
player.vel.copy(player.dodgeDir).multiplyScalar(dashSpeed);
player.dodgeTime -= dt;
} else {
// Smooth velocity toward desired
const desired = input.clone().multiplyScalar(speed);
player.vel.x += (desired.x - player.vel.x) * Math.min(1, dt * 14);
player.vel.z += (desired.z - player.vel.z) * Math.min(1, dt * 14);
}

// Integrate
const move = new THREE.Vector3(player.vel.x * dt, 0, player.vel.z * dt);
player.pos.add(move);
player.vel.multiplyScalar(Math.max(0, 1 - dt * 8));

// Collision with obstacles (AABB)
const pr = 0.4;
for (const o of G.obstacles) {
if (player.pos.x + pr > o.min.x && player.pos.x - pr < o.max.x &&
player.pos.z + pr > o.min.z && player.pos.z - pr < o.max.z &&
player.pos.y - 1.7 < o.max.y) {
// Push out on nearest axis
const dxL = (player.pos.x + pr) - o.min.x;
const dxR = o.max.x - (player.pos.x - pr);
const dzL = (player.pos.z + pr) - o.min.z;
const dzR = o.max.z - (player.pos.z - pr);
const minPen = Math.min(dxL, dxR, dzL, dzR);
if (minPen === dxL) player.pos.x -= dxL;
else if (minPen === dxR) player.pos.x += dxR;
else if (minPen === dzL) player.pos.z -= dzL;
else player.pos.z += dzR;
}
}

// Arena bounds
const bound = 70;
player.pos.x = Math.max(-bound, Math.min(bound, player.pos.x));
player.pos.z = Math.max(-bound, Math.min(bound, player.pos.z));

// Head bob
const spd = Math.hypot(player.vel.x, player.vel.z);
player.bob += dt * spd * 1.8;
const bobY = Math.sin(player.bob) * 0.04 * Math.min(1, spd/4);
const bobX = Math.cos(player.bob * 0.5) * 0.02 * Math.min(1, spd/4);

// Apply to camera
camera.position.set(player.pos.x + bobX, player.pos.y + bobY, player.pos.z);
camera.rotation.y = player.yaw;
camera.rotation.x = player.pitch;

// Pee mechanic
if (player.peeing) {
peeStream.visible = true;
// animate stream
peeStream.scale.z = 1 + Math.sin(performance.now() * 0.02) * 0.05;
if (G.inBoss) {
// damage handled in updateBoss
} else {
player.pee += dt;
if (player.pee >= player.peeMax) {
player.pee = player.peeMax;
player.peeing = false;
peeStream.visible = false;
advanceLevel();
}
}
} else {
peeStream.visible = false;
// Slow drain when not peeing so the meter isn't just waiting
if (!G.inBoss) player.pee = Math.max(0, player.pee - dt * 0.35);
}

updateHUD();
}

/* ============================ ENEMY SPAWNING ============================ */
function updateSpawning(dt) {
if (G.inBoss) return;
G.spawnTimer -= dt;
if (G.spawnTimer <= 0 && G.enemies.length < LEVELS[G.level].enemies + 2) {
G.spawnTimer = 8 + Math.random() * 8;
const kinds = ['pillbug', 'tapeworm', 'centipede'];
const k = kinds[Math.floor(Math.random() * 3)];
const ang = Math.random() * Math.PI * 2;
const rad = 28 + Math.random() * 15;
spawnEnemy(k, new THREE.Vector3(
player.pos.x + Math.cos(ang) * rad,
0,
player.pos.z + Math.sin(ang) * rad
));
}
// Rare heal spawns
if (Math.random() < dt * 0.02 && G.heals.length < 2) {
spawnHeal();
}
}

/* ============================ JUMPSCARE TIMER ============================ */
const JS = {
nextZombieTime: 40, // first at 40s
chuckyTime: null,
chuckyDone: false,
firstDone: false,
};

function updateJumpscares(nowSec) {
if (jsActive) {
if (performance.now() > jsEndTime) {
jsActive = false;
$('jumpscare-overlay').classList.remove('show');
}
return;
}
// Regular zombie every 40s
if (nowSec >= JS.nextZombieTime) {
triggerJumpscare('zombie');
JS.nextZombieTime += 40;
if (!JS.firstDone) {
JS.firstDone = true;
JS.chuckyTime = nowSec + 10;
}
}
// One-time chucky 10s after first
if (JS.chuckyTime && !JS.chuckyDone && nowSec >= JS.chuckyTime) {
triggerJumpscare('chucky');
JS.chuckyDone = true;
}
}

/* ============================ DEATH / WIN ============================ */
function die() {
if (G.playerDead) return;
G.playerDead = true;
G.running = false;
document.exitPointerLock && document.exitPointerLock();
const es = $('end-screen');
$('end-title').textContent = 'YOU DIED';
$('end-title').style.color = '#8a1a1a';
$('end-sub').textContent = `You fell in ${LEVELS[G.level].name}. The zone claims another.`;
es.classList.remove('hidden');
}

function winGame() {
if (G.won) return;
G.won = true;
G.running = false;
document.exitPointerLock && document.exitPointerLock();
const es = $('end-screen');
$('end-title').textContent = 'YOU REACHED THE METRO';
$('end-title').style.color = '#ccaa44';
$('end-sub').textContent = 'The Mother is dead. Somewhere above, dawn breaks.';
es.classList.remove('hidden');
}

/* ============================ START / RESTART ============================ */
function startGame() {
// Reset all state
clearLevel();
clearAtmosphere();
if (G.boss) { scene.remove(G.boss); G.boss = null; }

G.running = true;
G.paused = false;
G.playerDead = false;
G.won = false;
G.elapsed = 0;
G.spawnTimer = 3;
G.inBoss = false;

player.hp = player.maxHp;
player.pee = 0;
player.vel.set(0, 0, 0);
player.yaw = 0;
player.pitch = 0;
player.peeing = false;
player.invuln = 1.0;

JS.nextZombieTime = 40;
JS.chuckyTime = null;
JS.chuckyDone = false;
JS.firstDone = false;

$('start-screen').classList.add('hidden');
$('end-screen').classList.add('hidden');

loadLevel(0);

// Start background ambient drone
startAmbient();

canvas.requestPointerLock();
lastTime = performance.now();
}

$('start-btn').addEventListener('click', startGame);
$('restart-btn').addEventListener('click', startGame);

/* ============================ AMBIENT AUDIO ============================ */
let ambientNodes = null;
function startAmbient() {
if (ambientNodes) return;
try {
const AC = window.AudioContext || window.webkitAudioContext;
if (!AC) return;
const ctx = new AC();
const osc = ctx.createOscillator();
osc.type = 'sine';
osc.frequency.value = 55;
const osc2 = ctx.createOscillator();
osc2.type = 'sine';
osc2.frequency.value = 82.5;
const gain = ctx.createGain();
gain.gain.value = 0.04;
const lp = ctx.createBiquadFilter();
lp.type = 'lowpass';
lp.frequency.value = 300;
osc.connect(lp);
osc2.connect(lp);
lp.connect(gain).connect(ctx.destination);
osc.start();
osc2.start();
ambientNodes = { ctx, osc, osc2, gain };
} catch (e) { /* silent */ }
}

/* ============================ MAIN LOOP ============================ */
let lastTime = performance.now();
let elapsedSec = 0;

function animate(now) {
requestAnimationFrame(animate);
const dt = Math.min(0.05, (now - lastTime) / 1000);
lastTime = now;

if (G.running && !G.paused) {
elapsedSec += dt;
updatePlayer(dt);
updateEnemies(dt);
updateHeals(dt);
updateSpawning(dt);
if (G.inBoss) updateBoss(dt);
updateJumpscares(elapsedSec);

// Flicker ambient
if (G._sun) {
const flicker = 1 + Math.sin(now * 0.002) * 0.03 + (Math.random() - 0.5) * 0.02;
G._sun.intensity = G._sun.userData.baseIntensity
? G._sun.userData.baseIntensity * flicker
: G._sun.intensity;
}
}

renderer.render(scene, camera);
}

// Prevent default browser right-click menu so gameplay is smooth
window.addEventListener('contextmenu', e => e.preventDefault());

// Kick off the loop
requestAnimationFrame(animate);
</script>
